DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
LLM_API_KEY=your-llm-provider-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
# Optional second OpenAI-compatible provider. Leave both blank to disable failover.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Optional: leave blank for Clerk development/test keys.
VITE_CLERK_PROXY_URL=
